%f     15:1
%a     0:6
%b     12:3 24:3
%c     6:6
%cond  0:5
%u6    6:6
%s12   0:s6 6:6
%delay 5:1

%u6_dword  6:6      !function=ex_imm_dword
%s12_dword 0:s6 6:6 !function=ex_imm_dword

%u6_dhalf  6:6      !function=ex_imm_dhalf
%s12_dhalf 0:s6 6:6 !function=ex_imm_dhalf

%u6_qhalf  6:6      !function=ex_imm_qhalf
%s12_qhalf 0:s6 6:6 !function=ex_imm_qhalf

&dop_reg_reg  a b c f:bool
@dop_reg_reg  ........ 00 ......................   &dop_reg_reg %a %b %c %f

&dop_reg_u6   a b imm f:bool
@dop_reg_u6   ........ 01 ......................   &dop_reg_u6 %a %b imm=%u6 %f

&dop_reg_s12  b imm f:bool
@dop_reg_s12  ........ 10 ......................   &dop_reg_s12 %b imm=%s12 %f

&dop_cond_reg b c f:bool cond
@dop_cond_reg ........ 11 ................ 0 ..... &dop_cond_reg %b %c %f %cond

&dop_cond_u6  b imm f:bool cond
@dop_cond_u6  ........ 11 ................ 1 ..... &dop_cond_u6 %b imm=%u6 %f %cond

&sop_reg_reg  b c f:bool
@sop_reg_reg  ........ 00 101111 ................  &sop_reg_reg %b %c %f

&sop_reg_u6   b imm f:bool
@sop_reg_u6   ........ 01 101111 ................  &sop_reg_u6 %b imm=%u6 %f

# DMPY/DMAC variants of DOP general formats

&dop_reg_u6_dmpy   a b imm f:bool
@dop_reg_u6_dmpy   ........ 01 ......................   &dop_reg_u6_dmpy %a %b imm=%u6_dhalf %f

&dop_reg_s12_dmpy  b imm f:bool
@dop_reg_s12_dmpy  ........ 10 ......................   &dop_reg_s12_dmpy %b imm=%s12_dhalf %f

&dop_cond_u6_dmpy  b imm f:bool cond
@dop_cond_u6_dmpy  ........ 11 ................ 1 ..... &dop_cond_u6_dmpy %b imm=%u6_dhalf %f %cond

# QMPY/QMAC variants of DOP general formats

%u6_qmpy           6:6 !function=ex_imm_qhalf
%s12_qmpy          0:s6 6:6 !function=ex_imm_qhalf

&dop_reg_u6_qmpy   a b imm:int64_t f:bool
@dop_reg_u6_qmpy   ........ 01 ......................   &dop_reg_u6_qmpy %a %b imm=%u6_qmpy %f

&dop_reg_s12_qmpy  b imm:int64_t f:bool
@dop_reg_s12_qmpy  ........ 10 ......................   &dop_reg_s12_qmpy %b imm=%s12_qmpy %f

&dop_cond_u6_qmpy  b imm:int64_t f:bool cond
@dop_cond_u6_qmpy  ........ 11 ................ 1 ..... &dop_cond_u6_qmpy %b imm=%u6_qmpy %f %cond

