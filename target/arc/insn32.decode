# SIMD variants of DOP general formats

&dop_reg_reg_simd        a b c
@dop_reg_reg_simd        ........ 00 ...... 0 ...............   &dop_reg_reg_simd %a %b %c
@dop_reg_reg_simd_f1        ........ 00 ...... 1 ...............   &dop_reg_reg_simd %a %b %c

&dop_reg_u6_simd_vadd2   a b imm:int64_t
@dop_reg_u6_simd_vadd2   ........ 01 ...... 0 ...............   &dop_reg_u6_simd_vadd2 %a %b imm=%u6_dword
@dop_reg_u6_simd_vadd2_f1   ........ 01 ...... 1 ...............   &dop_reg_u6_simd_vadd2 %a %b imm=%u6_dword

&dop_reg_s12_simd_vadd2  b imm:int64_t
@dop_reg_s12_simd_vadd2  ........ 10 ...... 0 ...............   &dop_reg_s12_simd_vadd2 %b imm=%s12_dword
@dop_reg_s12_simd_vadd2_f1  ........ 10 ...... 1 ...............   &dop_reg_s12_simd_vadd2 %b imm=%s12_dword

&dop_cond_reg_simd       b c cond
@dop_cond_reg_simd       ........ 11 ...... 0 ......... 0 ..... &dop_cond_reg_simd %b %c %cond
@dop_cond_reg_simd_f1       ........ 11 ...... 1 ......... 0 ..... &dop_cond_reg_simd %b %c %cond

&dop_cond_u6_simd_vadd2  b imm:int64_t cond
@dop_cond_u6_simd_vadd2  ........ 11 ...... 0 ......... 1 ..... &dop_cond_u6_simd_vadd2 %b imm=%u6_dword %cond
@dop_cond_u6_simd_vadd2_f1  ........ 11 ...... 1 ......... 1 ..... &dop_cond_u6_simd_vadd2 %b imm=%u6_dword %cond

