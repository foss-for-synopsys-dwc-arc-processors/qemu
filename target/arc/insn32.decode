# LD and ST instructions (both 32-bit and 64-bit targets)

%ld_s9 15:s1 16:8
%st_s9 15:s1 16:8
%st_w6 6:s6

{
  lddl_offset     00010 ............... di:1 11   01 x:1 ...... %a %b imm=%ld_s9
  ldb_offset      00010 ............... di:1 aa:2 01 x:1 ...... %a %b imm=%ld_s9
}

{
  lddl_reg        00100 ... 11   11001 x:1 di:1 ............... %a %b %c
  ldb_reg         00100 ... aa:2 11001 x:1 di:1 ............... %a %b %c
}

ldh_offset        00010 ............... di:1 aa:2 10 x:1 ...... %a %b imm=%ld_s9
ldh_reg           00100 ... aa:2 11010 x:1 di:1 ............... %a %b %c

ld_offset         00010 ............... di:1 aa:2 000 ......    %a %b imm=%ld_s9
ld_reg            00100 ... aa:2 110000 di:1 ...............    %a %b %c

{
  prealloc_offset 00010 ............... 0 aa:2 001 111110       %b imm=%ld_s9
  ld_offset_sext  00010 ............... 0 aa:2 001 ......       %a %b imm=%ld_s9
}

{
  prealloc_reg    00100 ... aa:2 1100010 ......... 111110       %b %c
  ld_reg_sext     00100 ... aa:2 1100010 ......... ......       %a %b %c
}

ldd_offset        00010 ............... di:1 aa:2 110 ......    %a %b imm=%ld_s9
ldd_reg           00100 ... aa:2 110110 di:1 ...............    %a %b %c

ldl_offset        00010 ............... 1 aa:2 001 ......       %a %b imm=%ld_s9
ldl_reg           00100 ... aa:2 1100011 ...............        %a %b %c

ldi_b_c           00100 ... 001001100 ......... 000000 %b %c
ldi_b_u6          00100 ... 011001100 ......... 000000 %b offset=%u6
ldi_b_s12         00100 ... 101001100 ...............  %b offset=%s12

stb_reg           00011 ..................... di:1 aa:2 01 0 %b %c imm=%st_s9
stb_w6            00011 ..................... di:1 aa:2 01 1 simm_src=%st_w6 %b simm_offset=%st_s9

sth_reg           00011 ..................... di:1 aa:2 10 0 %b %c imm=%st_s9

{
  stdl_w6         00011 ..................... 1    aa:2 10 1 simm_src=%st_w6 %b simm_offset=%st_s9
  sth_w6          00011 ..................... di:1 aa:2 10 1 simm_src=%st_w6 %b simm_offset=%st_s9
}

st_reg            00011 ..................... di:1 aa:2 00 0 %b %c imm=%st_s9
st_w6             00011 ..................... di:1 aa:2 00 1 simm_src=%st_w6 %b simm_offset=%st_s9

{
  stdl_reg        00011 ..................... 1    aa:2 11 0 %b %c imm=%st_s9
  std_reg         00011 ..................... di:1 aa:2 11 0 %b %c imm=%st_s9
}

{
  stl_reg         00011 ..................... 0    aa:2 11 1 %b %c imm=%st_s9
  stl_w6          00011 ..................... 1    aa:2 11 1 simm_src=%st_w6 %b simm_offset=%st_s9
  std_w6          00011 ..................... di:1 aa:2 11 1 simm_src=%st_w6 %b simm_offset=%st_s9
}
