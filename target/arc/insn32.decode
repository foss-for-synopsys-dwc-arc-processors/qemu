# B, Bcc, BL, BLcc

# | Format                 | Major | Instruction                                      |
# | ---------------------- | ----- | ------------------------------------------------ |
# | F32_BR0:UCOND_FAR      | 0x0   | B<.d> s25 00000ssssssssss1SSSSSSSSSSNRtttt       |
# | F32_BR0:COND           | 0x0   | B<cc><.d> s21 00000ssssssssss0SSSSSSSSSSNQQQQQ   |
# | F32_BR1:BL:UCOND_FAR   | 0x1   | BL<.d> s25 00001sssssssss10SSSSSSSSSSNRtttt      |
# | F32_BR1:BL:COND        | 0x1   | BL<.cc><.d> s21 00001sssssssss00SSSSSSSSSSNQQQQQ |

%f32_br0_ucond_far_s25    0:s4 6:10 17:10 !function=ex_shl1
%f32_br0_cond_s21         6:s10 17:10 !function=ex_shl1
%f32_br1_bl_ucond_far_s25 0:s4 6:10 18:9 !function=ex_shl2
%f32_br1_bl_cond_s21      6:s10 18:9 !function=ex_shl2

&f32_br0_ucond_far     imm delay:bool
&f32_br0_cond          imm cond delay:bool
&f32_br1_bl_ucond_far  imm delay:bool
&f32_br1_bl_cond       imm cond delay:bool

b_far                  00000 .......... 1 ........... 0 .... &f32_br0_ucond_far imm=%f32_br0_ucond_far_s25 %delay
b_cond                 00000 .......... 0 ................   &f32_br0_cond imm=%f32_br0_cond_s21 %cond %delay
bl_far                 00001 ......... 10 ........... 0 .... &f32_br1_bl_ucond_far imm=%f32_br1_bl_ucond_far_s25 %delay
bl_cond                00001 ......... 00 ................   &f32_br1_bl_cond imm=%f32_br1_bl_cond_s21 %cond %delay

# BBIT0, BBIT1, BRCC

# | Format                 | Major | Instruction                                             |
# | ---------------------- | ----- | ------------------------------------------------------- |
# | F32_BR1:BCC:REG_REG    | 0x01  | <insn><.d><.T> b,c,s9  00001bbbsssssss1SBBBCCCCCCN0Yiii |
# | F32_BR1:BCC:REG_U6     | 0x01  | <insn><.d><.T> b,u6,s9 00001bbbsssssss1SBBBuuuuuuN1Yiii |

%bbit_s9    15:s1 17:7 !function=ex_shl1
%brcc_cond  0:3 !function=ex_brcc_cond

{
  bbit0l_reg 00001 .......... 1 .......... delay:1 0 1   110 %b %c offset=%bbit_s9
  bbit0_reg  00001 .......... 1 .......... delay:1 0 t:1 110 %b %c offset=%bbit_s9
  bbit1l_reg 00001 .......... 1 .......... delay:1 0 1   111 %b %c offset=%bbit_s9
  bbit1_reg  00001 .......... 1 .......... delay:1 0 t:1 111 %b %c offset=%bbit_s9
  brccl_reg  00001 .......... 1 .......... delay:1 0 1   ... %b %c offset=%bbit_s9 cond=%brcc_cond
  brcc_reg   00001 .......... 1 .......... delay:1 0 t:1 ... %b %c offset=%bbit_s9 cond=%brcc_cond
}

{
  bbit0l_imm 00001 .......... 1 .......... delay:1 1 1   110 %b imm=%u6 offset=%bbit_s9
  bbit0_imm  00001 .......... 1 .......... delay:1 1 t:1 110 %b imm=%u6 offset=%bbit_s9
  bbit1l_imm 00001 .......... 1 .......... delay:1 1 1   111 %b imm=%u6 offset=%bbit_s9
  bbit1_imm  00001 .......... 1 .......... delay:1 1 t:1 111 %b imm=%u6 offset=%bbit_s9
  brccl_u6   00001 .......... 1 .......... delay:1 1 1   ... %b imm=%u6 offset=%bbit_s9 cond=%brcc_cond
  brcc_u6    00001 .......... 1 .......... delay:1 1 t:1 ... %b imm=%u6 offset=%bbit_s9 cond=%brcc_cond
}

